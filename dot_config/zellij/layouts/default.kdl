layout {
    // ============================================================
    // Swap layouts
    // ============================================================
    //
    // Paste the output of:
    //
    //   zellij setup --dump-swap-layout default
    //
    // here if you want Zellij's stock swap layouts available.


    default_tab_template {
        children

        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {

                // ====================================================
                // Tokyo Night palette
                // ====================================================

                color_bg         "#1a1b26"
                color_bg_dark    "#16161e"
                color_bg_high    "#292e42"

                color_fg         "#c0caf5"
                color_fg_dark    "#a9b1d6"
                color_comment    "#565f89"

                color_blue       "#7aa2f7"
                color_cyan       "#7dcfff"
                color_teal       "#73daca"
                color_green      "#9ece6a"
                color_yellow     "#e0af68"
                color_orange     "#ff9e64"
                color_magenta    "#bb9af7"
                color_red        "#f7768e"


                // ====================================================
                // Overall bar
                // ====================================================

                format_left \
                    "{mode} #[bg=$bg,fg=$fg_dark,bold]{session}"

                format_center \
                    "{tabs}"

                format_right \
                    "{pipe_zjstatus_hints}{command_vpn}{swap_layout}"
                pipe_zjstatus_hints_format "{output}"

                // Blend unused space into the terminal.
                format_space \
                    "#[bg=$bg]"

                // Left > center > right when space gets tight.
                format_hide_on_overlength "true"
                format_precedence "lrc"

                // No separate zjstatus border.
                border_enabled "false"

                // Disabled because this causes rapid frame toggling
                // with the current Zellij/zjstatus combination.
                hide_frame_for_single_pane "false"


                // ====================================================
                // Modes
                //
                // Each mode owns its Powerline cap so the cap always
                // matches the mode's background color.
                // ====================================================

                mode_normal \
                    "#[bg=$green,fg=$bg,bold] NORMAL #[bg=$bg,fg=$green]"

                mode_locked \
                    "#[bg=$red,fg=$bg,bold] LOCKED #[bg=$bg,fg=$red]"

                mode_resize \
                    "#[bg=$yellow,fg=$bg,bold] RESIZE #[bg=$bg,fg=$yellow]"

                mode_pane \
                    "#[bg=$teal,fg=$bg,bold] PANE #[bg=$bg,fg=$teal]"

                mode_move \
                    "#[bg=$yellow,fg=$bg,bold] MOVE #[bg=$bg,fg=$yellow]"

                mode_tab \
                    "#[bg=$blue,fg=$bg,bold] TAB #[bg=$bg,fg=$blue]"

                mode_scroll \
                    "#[bg=$magenta,fg=$bg,bold] SCROLL #[bg=$bg,fg=$magenta]"

                mode_search \
                    "#[bg=$magenta,fg=$bg,bold] SEARCH #[bg=$bg,fg=$magenta]"

                mode_enter_search \
                    "#[bg=$magenta,fg=$bg,bold] SEARCH #[bg=$bg,fg=$magenta]"

                mode_rename_tab \
                    "#[bg=$blue,fg=$bg,bold] RENAME #[bg=$bg,fg=$blue]"

                mode_rename_pane \
                    "#[bg=$teal,fg=$bg,bold] RENAME #[bg=$bg,fg=$teal]"

                mode_session \
                    "#[bg=$cyan,fg=$bg,bold] SESSION #[bg=$bg,fg=$cyan]"

                mode_tmux \
                    "#[bg=$orange,fg=$bg,bold] TMUX #[bg=$bg,fg=$orange]"


                // ====================================================
                // Tabs
                //
                // Slim design:
                //
                //   1 shell    2 config
                //
                // Only the number is a colored badge. Active tab gets
                // Tokyo Night blue + bright/bold name.
                // ====================================================

                tab_normal \
                    "#[bg=$bg,fg=$bg_high]#[bg=$bg_high,fg=$fg_dark,bold]{index}#[bg=$bg,fg=$bg_high] #[bg=$bg,fg=$fg_dark]{name}{floating_indicator}"

                tab_active \
                    "#[bg=$bg,fg=$blue]#[bg=$blue,fg=$bg,bold]{index}#[bg=$bg,fg=$blue] #[bg=$bg,fg=$fg,bold]{name}{floating_indicator}"


                // ----------------------------------------------------
                // Fullscreen tabs
                // ----------------------------------------------------

                tab_normal_fullscreen \
                    "#[bg=$bg,fg=$bg_high]#[bg=$bg_high,fg=$fg_dark,bold]{index}#[bg=$bg,fg=$bg_high] #[bg=$bg,fg=$fg_dark]{name}{fullscreen_indicator}"

                tab_active_fullscreen \
                    "#[bg=$bg,fg=$blue]#[bg=$blue,fg=$bg,bold]{index}#[bg=$bg,fg=$blue] #[bg=$bg,fg=$fg,bold]{name}{fullscreen_indicator}"


                // ----------------------------------------------------
                // Synchronized-input tabs
                // ----------------------------------------------------

                tab_normal_sync \
                    "#[bg=$bg,fg=$bg_high]#[bg=$bg_high,fg=$fg_dark,bold]{index}#[bg=$bg,fg=$bg_high] #[bg=$bg,fg=$fg_dark]{name}{sync_indicator}"

                tab_active_sync \
                    "#[bg=$bg,fg=$blue]#[bg=$blue,fg=$bg,bold]{index}#[bg=$bg,fg=$blue] #[bg=$bg,fg=$fg,bold]{name}{sync_indicator}"


                // ----------------------------------------------------
                // Tab rename
                // ----------------------------------------------------

                tab_rename \
                    "#[bg=$bg,fg=$yellow]#[bg=$yellow,fg=$bg,bold]{index}#[bg=$bg,fg=$yellow] #[bg=$bg,fg=$fg,bold]{name}"


                // ----------------------------------------------------
                // Tab spacing and state indicators
                // ----------------------------------------------------

                tab_separator \
                    "   "

                tab_sync_indicator \
                    " 󰓦"

                tab_fullscreen_indicator \
                    " 󰊓"

                tab_floating_indicator \
                    " 󰹙"


                // ----------------------------------------------------
                // Lots of tabs
                // ----------------------------------------------------

                tab_display_count "9"

                tab_truncate_start_format \
                    "#[bg=$bg,fg=$comment]… +{count}   "

                tab_truncate_end_format \
                    "#[bg=$bg,fg=$comment]   +{count} …"


                // ====================================================
                // VPN
                //
                // Expected script output:
                //
                //   ""
                //   "TS"
                //   "GP"
                //   "TS GP"
                //
                // Poll every 60 seconds.
                // ====================================================

                command_vpn_command \
                    "fish"

                command_vpn_args \
                    "~/.config/zellij/scripts/vpn-status.fish"

                command_vpn_interval \
                    "60"

                command_vpn_rendermode \
                    "static"

                command_vpn_format \
                    "#[bg=$bg,fg=$teal]#[bg=$teal,fg=$bg,bold] {stdout} #[bg=$bg,fg=$teal] "


                // ====================================================
                // Swap layout
                // ====================================================

                swap_layout_format \
                    "#[bg=$bg,fg=$bg_high]#[bg=$bg_high,fg=$fg,bold] {name} #[bg=$bg,fg=$bg_high]"

                swap_layout_hide_if_empty \
                    "true"
            }
        }
    }
}
